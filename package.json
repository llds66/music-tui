{
  "name": "music.tui",
  "version": "0.1.2",
  "description": "在终端中播放本地音乐并显示同步歌词的 TUI 播放器",
  "homepage": "https://musictui.lldsss.com",
  "type": "module",
  "bin": {
    "music-tui": "dist/main.js"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--experimental-ffi --disable-warning=ExperimentalWarning\" vite",
    "build": "vite build",
    "start": "node --experimental-ffi --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "pnpm build"
  },
  "keywords": [
    "music",
    "player",
    "tui",
    "terminal",
    "mpv"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "llds <858400061@qq.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "dependencies": {
    "@opentui/core": "^0.6.6",
    "ascii.rest": "0.4.0",
    "string-width": "7.2.0",
    "vue": "^3.5.44",
    "vue-termui": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "3.3.7"
  },
  "engines": {
    "node": ">=26.3.0"
  }
}
